# 本地开发占位配置，请复制为 .env 后按需填写真实值。
NODE_ENV=development

# Web
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:3000

# API
API_PORT=3000
DATABASE_URL=postgresql://labelhub:labelhub_password@localhost:5432/labelhub?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace_with_local_jwt_secret

# Worker
BULLMQ_QUEUE_PREFIX=labelhub

# 存储
STORAGE_EXPORTS_DIR=storage/exports

# AI 模型。不设置 provider 时：有可用 DeepSeek key 则调用 DeepSeek，否则回退 mock。
# 如需强制演示模式，设置 LLM_PROVIDER=mock。
LLM_PROVIDER=
LLM_MODEL=deepseek-chat

# DeepSeek key 使用占位值或本机环境变量，不要提交真实密钥。
DEEPSEEK_API_KEY=replace_with_deepseek_api_key
