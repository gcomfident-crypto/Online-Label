{
  "name": "labelhub",
  "version": "0.0.0",
  "private": true,
  "description": "LabelHub 全栈标注平台工作区",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "dev:web": "pnpm -r --parallel --if-present dev:web",
    "dev:api": "pnpm -r --parallel --if-present dev:api",
    "dev:worker": "pnpm -r --parallel --if-present dev:worker",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:seed:demo": "prisma db seed",
    "demo:reset": "tsx prisma/demo-reset.ts",
    "lint": "pnpm -r --filter '@labelhub/*' --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "e2e": "pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.21",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "prisma": "^7.8.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^3.1.4"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0"
  }
}
